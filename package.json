{
  "name": "catalog-product",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "db:restore": "node --env-file-if-exists=.env.local scripts/restore.mjs",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-db.mjs",
    "e2e:api": "node --env-file-if-exists=.env.local scripts/e2e-api.mjs"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
